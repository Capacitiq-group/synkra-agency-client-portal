# ===========================================================================
# CANONICAL ENVIRONMENT VARIABLES - synkra-agency-client-portal
# Canonical names are primary. Legacy names are kept as working fallbacks
# for ONE deploy cycle only, then removed.
# ===========================================================================

# --- Shared PocketBase instance -------------------------------------------
# CANONICAL (public/client)
VITE_SYNKRA_PB_URL=https://<shared-instance-host>
# CANONICAL (server-only)
SYNKRA_PB_URL=https://<shared-instance-host>
# LEGACY FALLBACK - remove after one deploy cycle
VITE_POCKETBASE_URL=https://<shared-instance-host>
POCKETBASE_URL=https://<shared-instance-host>

# --- This app's own public base URL (not shared with other apps) ----------
# CANONICAL
SYNKRA_APP_URL=https://<portal-host>
# LEGACY FALLBACK - remove after one deploy cycle
APP_URL=https://<portal-host>

# --- Payments (server-only secret) ----------------------------------------
PAYSTACK_SECRET_KEY=

# --- PocketBase service account for this app ------------------------------
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
